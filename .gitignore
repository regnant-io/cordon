/target/
**/*.rs.bk
.env

# NOTE: Cargo.lock IS committed — this is a binary/application workspace, so a
# pinned lockfile gives reproducible builds and lets `cargo audit` run in CI.

# Key material — never commit
*.hex
*.pem
*.key
sanctum-keys/
cordon-keys/
**/cmk*

# Secrets
.env
*.env
cordon.env
sanctum.env

# Logs
*.jsonl
/var/

# Build artifacts
dist/

# IDE
.vscode/
.idea/
*.swp
